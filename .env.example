# ============================================================
# ELSAAD — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env* is gitignored — never commit secrets.
# ============================================================

# --- Phase 1 (Landing Page) ---
# Optional: canonical site URL for metadataBase / sitemap / robots.
# Auto-detected on Vercel (VERCEL_URL); falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://www.elsaad.com"

# --- Contact form email notifications (REQUIRED for launch) ---
# Resend (email notifications for contact form)
# Sign up at https://resend.com — free tier 100 emails/day
# RESEND_API_KEY="re_..."
# Where to send contact notifications:
# CONTACT_EMAIL_TO="info@elsaad.com"
# Sender address (must be verified in Resend if using custom domain):
# CONTACT_EMAIL_FROM="onboarding@resend.dev"

# --- Phase 2 (E-commerce + DB) — SCHEMA READY, DB NOT YET PROVISIONED ---
# Postgres connection string (Vercel Postgres / Neon / Supabase / local)
# DATABASE_URL="postgresql://user:password@host:5432/elsaad?schema=public"
#
# Once DATABASE_URL is set:
#   1. npm run db:push    — create tables + run Prisma client generation
#   2. npm run db:seed    — idempotent seed from lib/content.ts
#   3. npm run db:studio  — browse data (optional)
# The contact form persists ContactMessage rows automatically when
# DATABASE_URL is present; otherwise it falls back to console.log.

# Temporary admin auth for Phase 2B admin endpoints until Phase 2D auth
# ADMIN_API_KEY=""  # generate-with: openssl rand -base64 32

# NextAuth secret (when auth is added in Phase 2D)
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"

# --- Phase 3 (ERP integrations) — NOT YET USED ---
# Leave empty until ERP integration planning begins.
