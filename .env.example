# ============================================================
# ELSAAD — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env* is gitignored — never commit secrets.
# ============================================================

# --- Phase 1 (Landing Page) ---
# None required. Contact form logs to console and returns success.
# No external services called yet.

# --- Phase 2 (E-commerce + DB) — NOT YET USED ---
# Postgres connection string (Vercel Postgres / Neon / Supabase / local)
# DATABASE_URL="postgresql://user:password@host:5432/elsaad?schema=public"

# NextAuth secret (when auth is added)
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="http://localhost:3000"

# Prisma Accelerate (if using Prisma Data Platform)
# PRISMA_ACCELERATE_URL=""

# --- Phase 3 (ERP integrations) — NOT YET USED ---
# Leave empty until ERP integration planning begins.
