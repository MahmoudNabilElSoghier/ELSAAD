      "namedRegex": "^/admin/products(?:/)?$"
    },
    {
      "page": "/admin/products/new",
      "regex": "^/admin/products/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/products/new(?:/)?$"
    },
    {
      "page": "/brands",
      "regex": "^/brands(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/brands(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
