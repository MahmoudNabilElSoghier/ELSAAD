# API server
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database — local docker-compose credential (dev only).
# Leave unset to run on shared mock/demo data (withDb fallback).
DATABASE_URL=postgresql://elsaad:<password>@localhost:5432/elsaad
# docker-compose.yml sets POSTGRES_PASSWORD to: elsaad

# Redis — local docker-compose (host port 6380; not consumed by code yet)
REDIS_URL=redis://localhost:6380

# Storage — driver "local" (default, files under STORAGE_UPLOAD_DIR)
# or "minio" (docker compose up -d minio).
# MINIO_* are HOST-reachable addresses: API runs on the host, so it uses the
# published port 9010, not the container-internal 9000.
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=elsaad-docs
MINIO_REGION=us-east-1

# Admin API key — required for write endpoints (x-admin-api-key header).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-generate-a-real-key

# Local driver settings (STORAGE_DRIVER=local)
STORAGE_UPLOAD_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/api
