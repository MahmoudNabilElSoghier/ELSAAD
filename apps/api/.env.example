# API server
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database — local docker-compose credential (dev only).
DATABASE_URL=postgresql://elsaad:elsaad@localhost:5434/elsaad

# Redis — local docker-compose
REDIS_URL=redis://localhost:6380

# Storage — driver "local" or "minio"
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=elsaad-docs
MINIO_REGION=us-east-1

# Admin API key — required for write endpoints (x-admin-api-key header or dual auth)
ADMIN_API_KEY=change-me-generate-a-real-key

# Auth (Sprint 2D - JWT RS256 + Bootstrap Admin)
JWT_KEYS_DIR=./keys
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_BOOTSTRAP_EMAIL=admin@elsaad.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-secure-password

# Local driver settings
STORAGE_UPLOAD_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/api
