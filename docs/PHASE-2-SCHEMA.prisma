// DRAFT — historical Phase 2 schema proposal.
// SUPERSEDED by the active schema: prisma/schema.prisma (decisions applied).
// Do NOT migrate from this draft.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Phase 2A: Contact form persistence ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------- Phase 2B: Product catalog ----------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  price       Decimal?  @db.Decimal(10, 2)
  stock       Int       @default(0)
  imageUrl    String?
  active      Boolean   @default(true)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([active])
}

// ---------- Static content mirrored from lib/content.ts ----------

model Branch {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  address String
  phone   String
  hours   String
  order   Int     @default(0)
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  text      String
  rating    Int      @default(5)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Phase 2C: Orders (placeholder, refined later) ----------

model Order {
  id         String      @id @default(cuid())
  customer   String
  phone      String
  address    String?
  total      Decimal     @db.Decimal(10, 2)
  status     String      @default("pending")
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

