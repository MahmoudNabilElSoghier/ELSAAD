# ELSAAD - production environment template.
# Copy the values you need into Railway (API service) / Vercel (web project).
# NEVER put real credentials in this file. NEVER commit real .env files.

# ---------- API (Railway service, apps/api) ----------

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/elsaad?sslmode=require
NODE_ENV=production
PORT=4000
# Comma-separated list of allowed browser origins (your Vercel domain)
CORS_ORIGINS=https://your-app.vercel.app

# JWT (RS256). Paste the PEM file contents with literal \n escapes, e.g.:
#   node -e "console.log(require('fs').readFileSync('apps/api/keys/private.pem','utf8').replace(/\n/g,'\\n'))"
# Back up apps/api/keys/*.pem - losing them invalidates all sessions.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Write-endpoint fallback key (x-admin-api-key header). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-64-char-hex

# One-time admin account creation for db:seed (remove after first seed)
ADMIN_BOOTSTRAP_EMAIL=admin@elsaad.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Document storage: "minio" (S3-compatible) or "local" (filesystem, v1 fallback)
STORAGE_DRIVER=minio
MINIO_ENDPOINT=your-minio-host.example.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=elsaad-docs
MINIO_REGION=us-east-1
# Used only by STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=https://your-api.up.railway.app/api

# ---------- Web (Vercel project, apps/web) ----------

# Keep as "/api" - the same-origin rewrite proxies to API_ORIGIN
NEXT_PUBLIC_API_URL=/api
# Server-side rewrite target (next.config.ts) - your Railway URL
API_ORIGIN=https://your-api.up.railway.app
# Canonical site URL (robots/sitemap/og metadata)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
